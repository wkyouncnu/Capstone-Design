# ===========================================================
#  캡스톤디자인 저장소 — 무엇을 올리고 무엇을 올리지 않는가
#
#  올리는 것 : 직접 만든 강의자료(MD/PDF/SVG), Simulink 모델, MATLAB 코드, 스킬
#  올리지 않는 것 : 개인정보 · 저작권 자료 · 100 MB 초과 파일 · 빌드 산출물
# ===========================================================

# ── 1. 개인정보 — 절대 올리지 않는다 ──────────────────────
#    학번·이름·제출물. 공개 저장소에 올라가면 되돌릴 수 없다.
/5_학생제출물/

# ── 2. 저작권이 남에게 있는 자료 ──────────────────────────
#    교재·학술논문·외부 기관 발표자료. 배포권이 없다.
/2_지난학기_강의자료/
/4_참고자료/
/1_2026-2학기_강의자료/*.pdf
/1_2026-2학기_강의자료/*.pptx
/1_2026-2학기_강의자료/*.docx
/1_2026-2학기_강의자료/*.png
# 주차 자료 PDF 는 직접 만든 것이므로 위 규칙에서 되살린다
!/1_2026-2학기_강의자료/10-주차별-강의자료/**/*.pdf
!/1_2026-2학기_강의자료/10-주차별-강의자료/**/*.png

# ── 3. 외부 저장소를 그대로 복사해 둔 것 ──────────────────
#    VRX·mapviz 원본. 상류(upstream)에서 받는 것이 맞다.
/1_2026-2학기_강의자료/[[]2025[]] ROS2_VRX_Gazebo_Simulink/

# ── 4. 대용량 미디어 (GitHub 파일당 100 MB 제한) ──────────
*.mp4
*.avi
*.mov
*.wmv
*.zip

# ── 5. MATLAB · Simulink 빌드 산출물 (다시 만들어진다) ────
slprj/
*.slxc
*.asv
*.autosave
*.original
*.r2022a
*.r2023b
*.slx.r*

# ── 6. 편집기 · OS ────────────────────────────────────────
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
Thumbs.db
desktop.ini
.DS_Store
~$*

# ── 7. 자격증명 — 실수로라도 올라가면 안 된다 ─────────────
**/sessionDetails.json
*.pem
*.key
.env

# ── 8. 출결·성적 (개인정보) ───────────────────────────────
출석부*.xlsx

# 예제코드 폴더에 섞여 있는 학술논문 (저작권)
/3_예제코드/**/*.pdf
