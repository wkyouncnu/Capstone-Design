<?xml version="1.0" encoding="UTF-8"?>
<!-- wamv_ca_components.xacro — 충돌회피용 센서 배치 (9주차 2-2)
     ================================================================
     6주차에서 추진기 배치를 우리 xacro 로 바꿔 넣었던 것과 같은 수법이다.
     그때는 thruster_xacro_file, 이번에는 component_xacro_file 이다.

       xacro wamv_gazebo.urdf.xacro \
             yaml_component_generation:=true \
             component_xacro_file:=<이 파일>

     그러면 VRX 는 센서 켜고/끄기 스위치(lidar_enabled 따위) 를 무시하고
     아래 yaml_components 매크로가 적는 센서만 단다.

     왜 lidar_enabled:=true 를 쓰지 않는가
       lidar.xacro 의 lidar 매크로는 자리(x y z R P Y) 만 받고
       광선 수 · 샘플 수 · 주기 · 사거리는 받지 않는다. 그래서 그 길로는
       "라이다 성능을 낮춘 판" 을 만들 수 없다. 한 단계 아래의
       wamv_3d_lidar 를 직접 불러 네 값을 우리가 정한다.

     성능을 환경변수로 고른다 (make_wamv_ca.sh 가 넣어 준다)
       CA_LIDAR_BEAMS   세로 광선 수        16 | 8
       CA_LIDAR_SAMPLES 한 바퀴 샘플 수     1875 | 440 | 220
       CA_LIDAR_RATE    발행 주기 [Hz]      10 | 5
       CA_LIDAR_RANGE   최대 사거리 [m]     130 | 40 | 30
     한 스캔의 점 수 = BEAMS x SAMPLES. 이 수가 RTF 를 정한다.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="yaml_components">

    <!-- 제어에 쓰는 세 가지 — 6주차 wamv_bow_lite.urdf 와 같은 자리에 둔다.
         자리를 바꾸면 5·6주차에서 맞춰 둔 항법이 어긋난다. -->
    <xacro:wamv_gps name="gps_wamv" x="-0.85"/>
    <xacro:wamv_imu name="imu_wamv" y="-0.2"/>
    <xacro:wamv_p3d name="p3d_wamv"/>

    <!-- 3D LiDAR — 충돌회피가 쓰는 유일한 인지 센서.
         자리 : x=0.7 (선수 쪽), y=0 (중앙), z=1.9

         y 를 0 으로 둔 이유
           VRX 기본값은 y=-0.3 (우현으로 30cm 치우침) 이다. 360도 로 도는
           센서를 중심선에서 비켜 달면 좌우 거리가 30cm 씩 다르게 들어온다.
           회피는 좌우를 견주어 한쪽을 고르는 일이라, 치우침이 그대로 편향이 된다.

         z 를 1.9 로 올린 이유 — 계산으로 1.6 을 골랐다가 실측에서 틀린 것을 알았다
           처음 계산은 이랬다. 세로 시야가 +-15도 이므로 거리 d 에서 광선이 덮는
           높이는 +-d*tan(15도) 다. 낮게 달면 아래쪽 광선이 더 가까이서 수면에
           닿으니 키 낮은 부표를 가까이서도 문다 — 그래서 1.6 이 낫다고 보았다.

           probe_lidar_pose.sh 로 재 보니 1.6 에서 들어온 값의 82% 가 장애물이
           아니라 **자기 배** 였다. 거리가 0.35~2.3m 에 몰려 있었다.
           범인은 cpu_cases_link (z=1.53m) 의 상자다. 큰 쪽이 0.59 x 0.83 x 0.47m
           이라 윗면이 z=1.765m 다. 라이다를 그보다 낮게 달면 가로로 도는 광선이
           이 상자에 막힌다. 실측도 딱 그 선에서 갈린다 — 1.75 까지 82%, 1.80 부터 0%.

           1.80 은 여유가 3.5cm 뿐이다. 상자는 옆으로 0.4m 거리에 있으므로 배가
           5도 만 기울어도 광선이 3.5cm 움직인다 — 파도에서 다시 막힌다.
           1.9 로 두면 여유 13.5cm, 약 18도 까지 버틴다.

           대가는 눈앞이 조금 멀어지는 것뿐이다. 키 0.5m 부표가 아래쪽 광선에
           잡히는 최소 거리가 (z-0.5)/tan(15도) 이므로 1.8 에서 4.9m, 1.9 에서 5.2m —
           0.3m 늘어난다. 자기 배를 장애물로 보는 것보다 훨씬 가벼운 대가다.

           더 내릴 수는 없다 — 마스트 길이가 z-1.2965-0.05 라 1.35m 아래면 음수가 된다.
    -->
    <xacro:wamv_3d_lidar name="lidar_wamv"
                         x="$(optenv CA_LIDAR_X 0.7)" y="$(optenv CA_LIDAR_Y 0)" z="$(optenv CA_LIDAR_Z 1.9)"
                         vertical_lasers="$(optenv CA_LIDAR_BEAMS 16)"
                         samples="$(optenv CA_LIDAR_SAMPLES 440)"
                         update_rate="$(optenv CA_LIDAR_RATE 10)"
                         max_range="$(optenv CA_LIDAR_RANGE 40)"/>
  </xacro:macro>
</robot>
