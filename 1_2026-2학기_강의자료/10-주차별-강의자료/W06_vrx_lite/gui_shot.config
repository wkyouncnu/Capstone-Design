<?xml version="1.0"?>
<!-- gui_shot.config — 강의자료에 넣을 그림을 찍기 위한 Gazebo GUI 설정 (6주차 2-5)

     기본 GUI 는 오른쪽에 Component inspector · Entity tree 패널을 띄우고 아래에
     World control · World stats 를 겹쳐 놓는다. 화면을 설명하기에는 좋지만
     선수추진기를 가까이 찍으면 그 패널들이 배를 가린다. 그래서 그림을 찍을 때만
     3D 화면 하나로 띄운다 — 플러그인이 넷뿐이다.

       MinimalScene            3D 화면 그 자체
       GzSceneManager          서버가 보내는 장면을 3D 화면에 반영
       InteractiveViewControl  마우스로 돌리고 당기기
       CameraTracking          특정 모델 따라가기 (/gui/follow 서비스)

     쓰는 법
       bash run_vrx_bow.sh shot
     마우스 조작은 같다 — 왼쪽 끌기 회전, 가운데 끌기 이동, 바퀴 확대.
     패널이 없으므로 재생·정지 단추도 없다. 그림만 찍고 Ctrl+C 로 끝낸다. -->

<dialog name="quick_start" show_again="false"/>

<window>
  <width>1760</width>
  <height>980</height>
  <menus>
    <drawer default="false">
    </drawer>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <!-- 배가 스폰되는 자리 뒤쪽 위에서 내려다보는 초기 시점 (ENU, 라디안) -->
  <camera_pose>-538 160 4 0 0.15 0.5</camera_pose>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>

<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">5</property>
    <property key="height" type="double">5</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
</plugin>
