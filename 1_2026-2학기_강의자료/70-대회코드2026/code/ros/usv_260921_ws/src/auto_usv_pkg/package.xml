<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auto_usv_pkg</name>
  <version>0.0.0</version>
  <description>Autonomous USV mission package: coordinate transform, arc-based collision avoidance (Livox PointCloud2), and PX4 offboard command publishing.</description>
  <maintainer email="ansl@todo.todo">ansl</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>px4_msgs</depend>

  <!-- 실제 import 하는데 선언이 빠져 있던 것들 (rosdep 이 안 깔아줌) -->
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>      <!-- coordinate_transformer_node: Rotation -->
  <depend>python3-pyproj</depend>     <!-- coordinate_transformer_node: LLA→ECEF -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>