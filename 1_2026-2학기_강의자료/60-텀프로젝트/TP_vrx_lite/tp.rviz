# tp.rviz — 텀프로젝트 확인용 Rviz2 판 (9주차 w09_ca.rviz 에 카메라 영상을 더한 것)
#
#   핵심 한 줄 : Fixed Frame 은 반드시 wamv/wamv/base_link 다.
#   Rviz2 기본값 map 은 이 세계에 없는 좌표계라 모든 표시가 Status: Error 로 뜬다.
#
#   포인트클라우드의 frame_id 는 wamv/wamv/base_link/lidar_wamv_sensor 이고
#   /tf_static 이 아니라 /tf 로 들어온다 (실측). 그래서 static_transform_publisher
#   를 따로 띄울 필요가 없다 — Fixed Frame 만 맞추면 그려진다.
#
#   센서 QoS 는 Best Effort 다. Reliable 로 구독하면 한 줄도 안 들어온다.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /PointCloud2 (라이다)1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (5 m 눈금)
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 20
      Color: 100; 100; 100
      Alpha: 0.4
    - Class: rviz_default_plugins/TF
      Name: TF (좌표계 나무)
      Enabled: false
      Marker Scale: 2
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud2 (라이다)
      Enabled: true
      Topic:
        Value: /wamv/sensors/lidars/lidar_wamv_sensor/points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.2
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Decay Time: 0
      Position Transformer: XYZ
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (/scan, 한 층만)
      Enabled: true
      Topic:
        Value: /wamv/sensors/lidars/lidar_wamv_sensor/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Spheres
      Size (m): 0.3
      Color: 255; 60; 60
      Color Transformer: FlatColor
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: Image (전방 카메라)
      Enabled: true
      Topic:
        Value: /wamv/sensors/cameras/front_camera_sensor/image_raw
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
      Transport Hint: raw
  Global Options:
    Fixed Frame: wamv/wamv/base_link
    Background Color: 32; 36; 40
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 45
      Pitch: 0.65
      Yaw: 3.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: wamv/wamv/base_link
Window Geometry:
  Height: 820
  Width: 1400
  Displays:
    collapsed: false
  Image (전방 카메라):
    collapsed: false
